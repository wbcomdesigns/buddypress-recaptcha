# Static analysis for Wbcom CAPTCHA Manager.
#
# Run with: composer phpstan
#
# The stubs are what make this trustworthy. Without them PHPStan does not know what
# WordPress or BuddyPress are, so every core function reads as "undefined" and the few
# real findings drown in hundreds of false ones. That is exactly what happened on the
# 2026-07-14 scan: 18 "undefined method WBC_Login_Widget::get_field_id()" errors, when
# the class extends WP_Widget and WordPress core defines that method.
#
# Optional paths are marked (?) on purpose. PHPStan refuses to run AT ALL if an
# excludePaths entry does not exist on disk - this config previously excluded
# node_modules and dist, neither of which exist here, so the analysis never ran.
#
# phpstan-wordpress is included explicitly, exactly as in the other plugins.
# The EDD licensing SDK is plain-vendored at libs/edd-sl-sdk (uniform Wbcom layout,
# kept in sync with BuddyNext's copy) and excluded below - it is third-party code
# with its own upstream. Root vendor/ is dev-only and gitignored.
includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor
            - libs
            - node_modules (?)
            - dist (?)
            - assets (?)
            - languages (?)
            # Vendored third-party library. We take the class + REST route only, and do
            # not maintain its internals, so its findings are not ours to act on.
            - includes/lib/altcha
    scanFiles:
        - vendor/gin0115/buddypress-stubs/buddypress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
    ignoreErrors:
        # Optional integrations. Each call site is guarded by function_exists()/class_exists(),
        # and we do not ship stubs for these plugins, so "not found" here means "not installed",
        # not "broken".
        - '#Function bbp_add_error not found\.#'
        - '#Function edd_set_error not found\.#'
        - '#Function UM not found\.#'
        - '#Function wpforms not found\.#'
        - '#(invalid return type|invalid type|unknown class) WPCF7_#'
        # Constants defined in the main plugin file at runtime.
        - '#Constant RFB_PLUGIN_(URL|PATH) not found\.#'
