parameters:
	ignoreErrors:
		-
			message: "#^Property Recaptcha_For_BuddyPress_Admin\\:\\:\\$plugin_name is never read, only written\\.$#"
			count: 1
			path: admin/class-recaptcha-for-buddypress-admin.php

		-
			message: "#^Property Recaptcha_For_BuddyPress_Admin\\:\\:\\$version is never read, only written\\.$#"
			count: 1
			path: admin/class-recaptcha-for-buddypress-admin.php

		-
			message: "#^Else branch is unreachable because previous condition is always true\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Else branch is unreachable because ternary operator condition is always true\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Offset 'crop' on \\*NEVER\\* in isset\\(\\) always exists and is not nullable\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Offset 'width' on string\\|null in isset\\(\\) does not exist\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^If condition is always true\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Method WBC_BuddyPress_Settings_Page\\:\\:wbc_current_secret_key\\(\\) is unused\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Method WBC_BuddyPress_Settings_Page\\:\\:wbc_current_site_key\\(\\) is unused\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Method WBC_BuddyPress_Settings_Page\\:\\:wbc_protection_checkbox_group\\(\\) is unused\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Method WBC_BuddyPress_Settings_Page\\:\\:wbc_service_key_fields\\(\\) is unused\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Method WBC_BuddyPress_Settings_Page\\:\\:wbc_service_signup_links\\(\\) is unused\\.$#"
			count: 1
			path: admin/includes/class-wbc-buddypress-settings-page.php

		-
			message: "#^Offset 'icon' on array\\{name\\: string, logo\\: 'buddynext\\.svg', icon\\: 'groups', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'buddyx\\.png', icon\\: 'admin\\-appearance', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'eventonomy\\.svg', icon\\: 'calendar\\-alt', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'jetonomy\\.svg', icon\\: 'format\\-chat', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'learnomy\\.svg', icon\\: 'welcome\\-learn\\-more', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'listora\\.svg', icon\\: 'list\\-view', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'mediaverse\\.svg', icon\\: 'format\\-gallery', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'wb\\-gamification\\.svg', icon\\: 'awards', desc\\: string, url\\: 'https\\:/…'\\}\\|array\\{name\\: string, logo\\: 'wp\\-career\\-board\\.svg', icon\\: 'businessman', desc\\: string, url\\: 'https\\:/…'\\} in isset\\(\\) always exists and is not nullable\\.$#"
			count: 1
			path: includes/admin/views/discover.php

		-
			message: "#^Right side of && is always true\\.$#"
			count: 1
			path: includes/admin/views/shell.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 1
			path: includes/captcha-verification-helper.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 2
			path: includes/class-captcha-service-manager.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 4
			path: includes/class-captcha-service-manager.php

		-
			message: "#^Action callback returns WP_Error but should not return anything\\.$#"
			count: 3
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns array but should not return anything\\.$#"
			count: 1
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns array\\|WP_Error but should not return anything\\.$#"
			count: 2
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns bool\\|WP_Error but should not return anything\\.$#"
			count: 1
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Filter callback return statement is missing\\.$#"
			count: 1
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^If condition is always true\\.$#"
			count: 1
			path: includes/class-settings-integration.php

		-
			message: "#^Right side of && is always true\\.$#"
			count: 1
			path: includes/class-settings-integration.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 1
			path: includes/services/class-recaptcha-v3-service.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/services/class-recaptcha-v3-service.php

		-
			message: "#^Access to an undefined property BuddyPress\\:\\:\\$signup\\.$#"
			count: 1
			path: public/bp-classes/Registrationbp.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 4
			path: public/class-recaptcha-for-buddypress-public.php

		-
			message: "#^Variable \\$context in empty\\(\\) always exists and is not falsy\\.$#"
			count: 1
			path: public/woocommerce-extra/Woocommerce_Order.php
