parameters:
	ignoreErrors:
		-
			message: "#^Property Recaptcha_For_BuddyPress_Admin\\:\\:\\$plugin_name is never read, only written\\.$#"
			count: 1
			path: admin/class-recaptcha-for-buddypress-admin.php

		-
			message: "#^Property Recaptcha_For_BuddyPress_Admin\\:\\:\\$version is never read, only written\\.$#"
			count: 1
			path: admin/class-recaptcha-for-buddypress-admin.php

		-
			message: "#^Else branch is unreachable because previous condition is always true\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Else branch is unreachable because ternary operator condition is always true\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Offset 'crop' on \\*NEVER\\* in isset\\(\\) always exists and is not nullable\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Offset 'width' on string\\|null in isset\\(\\) does not exist\\.$#"
			count: 1
			path: admin/includes/class-settings-renderer.php

		-
			message: "#^Right side of && is always true\\.$#"
			count: 1
			path: includes/admin/views/layout.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 1
			path: includes/captcha-verification-helper.php

		-
			message: "#^Action callback returns WP_Error but should not return anything\\.$#"
			count: 3
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns array but should not return anything\\.$#"
			count: 1
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns array\\|WP_Error but should not return anything\\.$#"
			count: 2
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Action callback returns bool\\|WP_Error but should not return anything\\.$#"
			count: 1
			path: includes/class-recaptcha-for-buddypress.php

		-
			message: "#^Ternary operator condition is always true\\.$#"
			count: 1
			path: includes/services/class-recaptcha-v3-service.php

		-
			message: "#^Access to an undefined property BuddyPress\\:\\:\\$signup\\.$#"
			count: 1
			path: public/bp-classes/Registrationbp.php

		-
			message: "#^Negated boolean expression is always false\\.$#"
			count: 1
			path: public/class-recaptcha-for-buddypress-public.php

		-
			message: "#^Variable \\$context in empty\\(\\) always exists and is not falsy\\.$#"
			count: 1
			path: public/woocommerce-extra/Woocommerce_Order.php
